        { "book": 30, "why": "vectors, matrices, eigenvalues, probability, calculus, backprop, information theory — the math underneath all 13 AI books." },
        { "book": 8,  "role": "keystone", "why": "tokenization, attention, transformers, RLHF — five downstream books depend on this." }
      ]
    },
    {
      "phase": 4,
      "title": "Meaning, Context & Retrieval",
      "books": [
        { "book": 18, "why": "embeddings, vector search — lifted from shelf #18; RAG/context/multimodal all need it." },
        { "book": 9,  "why": "chunking, reranking, Lost-in-the-Middle" },
        { "book": 10, "why": "RAG mastery — needs embeddings + context" }
      ]
    },
    {
      "phase": 5,
      "title": "Make the Model Act · কাজে নামানো",
      "books": [
        { "book": 19, "why": "function calling, MCP — hard prereq for agents." },
        { "book": 12, "why": "ReAct, planning, multi-agent — built on tools" }
      ]
    },
    {
      "phase": 6,
      "title": "Classic ML → Harden & Go Deep",
      "note": "🌱 Book 31 gives you the classic ML foundation (regression → neural networks) that every PhD interview demands. Then harden your LLMs.",
      "books": [
        { "book": 31, "why": "linear/logistic regression, decision trees, SVM, k-NN, k-means, neural network fundamentals — the No Free Lunch toolbox." },
        { "book": 13, "why": "prompt injection, red-teaming, guardrails" },
        { "book": 11, "why": "LoRA/QLoRA, DPO/PPO" }
