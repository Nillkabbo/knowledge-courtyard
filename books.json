  "roadmap": [
    {
      "phase": 0,
      "title": "Learn How to Learn · শেখার গলা",
      "note": "Do this first — it roughly doubles the retention of every book that follows.",
      "books": [
        { "book": 26, "why": "Ebbinghaus, Adler, Zettelkasten, Feynman, second-brain — referenced by 27 & 28, so upstream of both." },
        { "book": 5,  "why": "growth mindset, spaced repetition, active recall, sleep" },
        { "book": 25, "why": "20h vs 10,000h, Dunning-Kruger, metacognition" }
      ]
    },
    {
      "phase": 1,
      "title": "Mindset & North Star · মন ও দিক",
      "books": [
        { "book": 21, "why": "curiosity, question-crafting, intellectual humility" },
        { "book": 23, "why": "permanent vs perishable skills, systems thinking" },
        { "book": 24, "why": "biases, Cialdini, learned helplessness — referenced by 27 & 28." },
        { "book": 32, "why": "daily operating system — brain hacks, habits, state regulation. Read alongside 5 & 25 for immediate practical gains." },
        { "book": 33, "why": "completes the mind trilogy — 24 defends the mind, 32 maintains the brain, 33 sharpens the thinking. Ten tools: latticework, logic, fallacies, Bayes, first principles, Polya, Fermi, decisions, second-order." },
        { "book": 34, "why": "the evidence foundation — statistics & experimental design. Al-Kindi to Pearl, 1167 years. How to PROVE ideas work: hypothesis testing, confidence intervals, A/B testing, causal inference, replication crisis. The keystone that validates all other books." }
      ]
    },
    {
      "phase": 2,
      "title": "The Map & the Engineer's Craft",
      "books": [
        { "book": 1,  "why": "read inspectionally — the flyover of all 13 deep-dives." },
        { "book": 3,  "why": "first principles, abstraction, debugging" },
        { "book": 7,  "why": "prompt & context engineering — most immediately useful skill" }
      ]
    },
    {
      "phase": 3,
      "title": "Math Foundations → What an LLM Actually Is · the keystone",
      "note": "📖 Book 30 teaches the math (vectors → entropy) that every door below depends on. Then Book 8 unlocks the transformer.",
